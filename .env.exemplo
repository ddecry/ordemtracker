# Copie este arquivo para .env e preencha os valores. Nunca publique o .env.
# YouTube Data API v3: https://console.cloud.google.com (APIs e serviços > Credenciais > Chave de API)
YOUTUBE_API_KEY=
# Twitch: https://dev.twitch.tv/console/apps (Registrar aplicativo, categoria "Website Integration")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: https://kick.com/settings/developer (criar app)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Senha do painel guardada só como hash (gere com: node -e "const c=require('crypto'),s=c.randomBytes(16);console.log('scrypt$'+s.toString('hex')+'$'+c.scryptSync(process.argv[1],s,32).toString('hex'))" "sua senha")
ADMIN_SENHA_HASH=
# Endereço do painel, ex.: /menu/admin
ADMIN_CAMINHO=
# Opcionais
# PORT=3030
# DATA_DIR=/dados
# TikTok (sem API oficial; vazio desliga)
TIKTOK_CANAL=ordemparanormal
# Gemini (Google AI Studio, nível gratuito, sem cartão): momentos do episódio
GEMINI_API_KEY=
# 1 grava áudio e capturas da live pública para a análise (precisa de ffmpeg e yt-dlp; o Docker já traz)
GRAVACAO=0
# Groq (opcional, nível gratuito): ANALISE=groq usa a Groq em vez do Gemini para os momentos
GROQ_API_KEY=
ANALISE=
# endereço público do site, usado nas prévias de link
SITE_URL=https://ordemtracker.site

# só no PC: ferramentas/cortes-video.js acha os cortes do vídeo completo (o YouTube barra download no servidor)
CORTES_SSH=usuario@servidor
CORTES_CHAVE=~/.ssh/chave
